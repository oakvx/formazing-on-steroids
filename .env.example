# Formazing: copy as .env and fill with real values outside Git.
# Generate a strong Flask session signing secret:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# The application REFUSES to start without >=32 characters.
FLASK__SECRET_KEY=
FLASK__PORT=5000
FLASK__HOST=127.0.0.1
FLASK__DEBUG_MODE=false
# Set true ONLY when serving the app over HTTPS (TLS reverse proxy).
FLASK__SESSION_COOKIE_SECURE=false

# Persist on local disk outside the public/static directory.
# Mount and back up this directory if running Flask in Docker.
APP__OPERATIONS_DB=var/operations.sqlite3

# Microsoft Entra registration: configure exactly this redirect URI.
MSAL_REDIRECT_URI=http://localhost:5000/auth/callback
MICROSOFT__CLIENT_ID=
MICROSOFT__CLIENT_SECRET=
MICROSOFT__TENANT_ID=

# Comma-separated exact email domains and explicit admin accounts.
AUTH__ALLOWED_DOMAINS=jemore.it
AUTH__ADMIN_USERS=

# Existing service credentials (never commit .env or dump it to logs).
NOTION__TOKEN=
NOTION__DATABASE_ID=
TELEGRAM__BOT_TOKEN=
